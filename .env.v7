# ══════════════════════════════════════════════════════════════════════
# NexusAI v7.0 AUDIT — Environment Configuration
# Raport: TigerBeetle Shadow Ledger v7.0
# ══════════════════════════════════════════════════════════════════════

# ── TigerBeetle ──────────────────────────────────────────────────────
TB_CLUSTER_ID=0                           # 0=dev single-node, 42=production
TB_UNIX_SOCKET=/tmp/nexus-tb.sock        # UNIX socket path
TB_REPLICA_ADDRESSES=3000                 # TCP addresses (comma-separated for cluster)
PENDING_TIMEOUT_SECONDS=3600              # v7.0: Auto-void pending after 1h

# ── NATS JetStream ───────────────────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=nexus_events
NATS_SUBJECT_PREFIX=nexus.tb              # v7.0: Event subjects prefix

# ── Integrity Health Check ───────────────────────────────────────────
INTEGRITY_CHECK_INTERVAL_SECONDS=60       # v7.0: Proof chain verification interval
INTEGRITY_AUTO_LOCK=true                  # v7.0: Auto-lock system on violation
INTEGRITY_MAX_CONSECUTIVE_FAILURES=3      # v7.0: Failures before auto-lock

# ── Shadow Reconciliation ────────────────────────────────────────────
RECONCILIATION_INTERVAL_SECONDS=60        # v7.0: TB→DuckDB sync interval
RECONCILIATION_AUTO_HEAL=true             # v7.0: Auto-heal on drift
RECONCILIATION_DRIFT_THRESHOLD_COUNT=5    # v7.0: Max allowed transfer count diff
RECONCILIATION_DRIFT_THRESHOLD_MINOR=100  # v7.0: Max allowed amount diff (1 PLN)

# ── LedgerGuard (Fraud Detection) ───────────────────────────────────
LEDGERGUARD_HIGH_VALUE_THRESHOLD=1000000  # v7.0: 10k PLN threshold (in minor units)
LEDGERGUARD_BUSINESS_HOURS_START=7        # v7.0: Business hours start (7:00)
LEDGERGUARD_BUSINESS_HOURS_END=20         # v7.0: Business hours end (20:00)
LEDGERGUARD_AUTO_BLOCK=true               # v7.0: Auto-block suspicious transfers
LEDGERGUARD_DUPLICATE_WINDOW_SECONDS=1    # v7.0: Duplicate detection window

# ── Continuous Audit ─────────────────────────────────────────────────
CONTINUOUS_AUDIT_AUTO_BLOCK=true          # v7.0: Auto-block on audit violation
CONTINUOUS_AUDIT_RULES_COUNT=10           # v7.0: Active audit rules

# ── Auto-Healing Ledger ──────────────────────────────────────────────
AUTOHEAL_CHECK_INTERVAL_SECONDS=60        # v7.0: 3-layer consistency check interval
AUTOHEAL_AUTO_HEAL=true                   # v7.0: Auto-repair inconsistencies

# ── Pending Timeout Manager ──────────────────────────────────────────
PENDING_SCAN_INTERVAL_SECONDS=60          # v7.0: Scan interval for expired pending
PENDING_DEFAULT_TIMEOUT_SECONDS=3600      # v7.0: Default pending timeout

# ── NBP Client ───────────────────────────────────────────────────────
NBP_API_BASE_URL=https://api.nbp.pl/api   # v7.0: NBP API base URL
NBP_SYNC_HOURS=8,14                       # v7.0: Daily sync at 8:00 and 14:00
NBP_REQUEST_TIMEOUT=10                     # v7.0: API request timeout

# ── ML Predictors ───────────────────────────────────────────────────
ML_CASHFLOW_FORECAST_DAYS=90              # v7.0: Cash flow forecast horizon
ML_WHATIF_HISTORY_MONTHS=12               # v7.0: Historical data for ML predictions

# ── PostgreSQL Adapter ───────────────────────────────────────────────
PG_DSN=postgresql://localhost:5432/nexusai  # v7.0: PostgreSQL connection

# ── HMAC Signing ─────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
# SIGNING_KEY=your_64_char_hex_key_here
