# =============================================================================
# NexusAI - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# Default values work for local development with just NATS running.
# For stage/prod, you MUST set NEXUS_JWT_SECRET and NEXUS_ENCRYPTION_KEY.

# ── Core ──────────────────────────────────────────────────────────────────────
NEXUS_ENV=dev                     # Environment: dev, stage, or prod
NEXUS_DEBUG=1                     # Enable debug mode (1 or 0)
NEXUS_HOST=127.0.0.1             # API server bind address
NEXUS_PORT=8000                   # API server port
NEXUS_BASE_DIR=.                  # Base directory for data storage
NEXUS_LOG_LEVEL=info              # Logging level

# ── Security ──────────────────────────────────────────────────────────────────
NEXUS_JWT_SECRET=                 # Auto-generated for dev if empty; REQUIRED for stage/prod
NEXUS_JWT_EXPIRATION_SECONDS=900  # JWT token expiry in seconds
NEXUS_JWT_ISSUER=nexus-ai         # JWT issuer claim
NEXUS_JWT_AUDIENCE=nexus-api      # JWT audience claim
NEXUS_REFRESH_TOKEN_DAYS=30       # Refresh token validity in days
NEXUS_ADMIN_USERNAME=admin        # Default admin username
NEXUS_ADMIN_PASSWORD=admin        # Default admin password
NEXUS_ENCRYPTION_KEY=             # 32-byte base64-url key; REQUIRED for stage/prod
NEXUS_SQLCIPHER_KEY=              # SQLCipher database encryption key
NEXUS_SQLCIPHER_KEY_ENV=NEXUS_SQLCIPHER_KEY

# ── Database ──────────────────────────────────────────────────────────────────
NEXUS_SQLITE_FILE=nexus_oltp.db
NEXUS_DUCKDB_FILE=nexus_olap.duckdb
NEXUS_DUCKDB_MEMORY_LIMIT=512MB
NEXUS_DUCKDB_THREADS=2
NEXUS_IDEMPOTENCY_DB=idempotency.sqlite

# ── NATS (Message Broker) ────────────────────────────────────────────────────
NEXUS_NATS_URL=nats://localhost:4222
NEXUS_MAX_PARALLEL_OCR=1
NEXUS_OCR_TIMEOUT_SEC=300
NEXUS_MODEL_CACHE_TTL_SEC=600
NEXUS_OUTBOX_REPLAY_LIMIT=100

# ── Storage & Uploads ─────────────────────────────────────────────────────────
NEXUS_STORAGE_DIR=app_data/uploads
NEXUS_MAX_INVOICE_UPLOAD_MB=50
NEXUS_MAX_ATTACHMENT_UPLOAD_MB=500

# ── CORS ──────────────────────────────────────────────────────────────────────
NEXUS_CORS_ORIGINS=*

# ── AI Model Paths ────────────────────────────────────────────────────────────
NEXUS_COUNCIL_ALPHA_MODEL=models/LFM2.5-1.2B-Q4_K_M.gguf
NEXUS_COUNCIL_BETA_MODEL=models/Qwen3-0.6B-Q4_K_M.gguf
NEXUS_COUNCIL_GAMMA_MODEL=models/LittleLamb-0.3B-Q4_K_M.gguf
NEXUS_RULES_MODEL=models/granite-4.0-1b-nano-Q4_K_M.gguf
NEXUS_ANALYTICS_MODEL=models/qwen2.5-1.5b-instruct-Q4_K_M.gguf
NEXUS_FIN_DETECTIVE_MODEL=models/fin-rwkv-169m.pth
NEXUS_DECISION_JAMBA_MODEL=models/Jamba-Reasoning-3B-Q4_K_M.gguf
NEXUS_DECISION_GRANITE_MODEL=models/granite-4.0-1b-nano-Q4_K_M.gguf
NEXUS_ORCHESTRATOR_MODEL=models/LittleLamb-0.3B-Q4_K_M.gguf

# ── Decision Thresholds ───────────────────────────────────────────────────────
NEXUS_AUTOPILOT_AUTO_POST=0.92
NEXUS_AUTOPILOT_SUGGEST=0.75
NEXUS_AUTOPILOT_ASK=0.50
NEXUS_AUTOPILOT_ADAPTATION=1
NEXUS_AUTOPILOT_LEARNING_RATE=0.05
NEXUS_AUTOPILOT_LOW_AMOUNT=500.0
NEXUS_AUTOPILOT_MODEL_TTL=600
NEXUS_AUTOPILOT_AGENT_TIMEOUT=30
NEXUS_AUTOPILOT_VENDOR_ALPHA_MIN=3

# ── Rules Agent ───────────────────────────────────────────────────────────────
NEXUS_RULES_MAX_AMOUNT=100000.0
NEXUS_RULES_REQUIRE_NIP=1

# ── Analytics ─────────────────────────────────────────────────────────────────
NEXUS_ANALYTICS_ANOMALY_THRESHOLD=2.0
NEXUS_DECISION_TIMEOUT=60

# ── Infiscal (Secrets Management Fallback) ────────────────────────────────────
NEXUS_INFISCAL_JWT_SECRET=
NEXUS_INFISCAL_ENCRYPTION_KEY=

# ── TigerBeetle ───────────────────────────────────────────────────────────────
TB_CLUSTER_ID=0
TB_REPLICA_ADDRESSES=3000

# ── OpenTelemetry / Monitoring ────────────────────────────────────────────────
NEXUS_OTEL_BUFFER_MAX_RECORDS=50000
NEXUS_SECURITY_SCAN_TIMEOUT_SEC=1800
NEXUS_PERF_K6_TIMEOUT_SEC=3600

# ── Sentry (Error Tracking) ───────────────────────────────────────────────────
NEXUS_SENTRY_DSN=
NEXUS_DPO_ALERT_WEBHOOK=

# ── Miscellaneous ─────────────────────────────────────────────────────────────
NEXUS_TRUST_PROXY=0
NEXUS_MIGRATION_BASELINE_FILE=migration_rowcount_baseline.json
NEXUS_MIGRATION_CHECKSUM_BASELINE_FILE=migration_checksum_baseline.json
