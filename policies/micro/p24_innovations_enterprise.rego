    "_warnings": ["[P24-I10] Auto-klasyfikator: powierzchnia PRZEKRACZA 300 m2! Stawka 8% NIE ma zastosowania. Całość = VAT 23%."]
} {
    object.get(input.invoice, "building_type", "") == "RESIDENTIAL"
    object.get(input.invoice, "usable_area_m2", 0) > 300
}

