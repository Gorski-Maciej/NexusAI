# ╚══════════════════════════════════════════════════════════════════════════════╝

# jdg.p24.i7.r1: i7_recommend_lump_sum_low_costs
decide := {
    "matched": true,
    "rule_id": "jdg.p24.i7.r1",
    "_routing": "",
    "package": "jdg.p24.innovations",
    "priority": 210060,
    "recommended_tax_form": "RYCZALT",
    "_routing_reason": "I7: Rekomendacja RYCZAŁT — niskie koszty, wysoki przychód, stawka < 12%",
    "_legal_basis": "Art. 2, 6, 12 ustawy o ryczałcie",
    "_warnings": ["[P24-I7] DECYZJA: Ryczałt! Twoje koszty są niskie (<30% przychodu), a stawka ryczałtu (3-8,5%) niższa niż efektywna stawka na skali. Oszczędność: ~15% podatku."]
} {
