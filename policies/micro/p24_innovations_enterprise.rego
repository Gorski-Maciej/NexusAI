    "_legal_basis": "Art. 41 ust. 1 VAT",
    "_warnings": ["[P24-I4] Kalkulator budowlany: budynek niemieszkalny = VAT 23%. Sprawdź, czy nie ma reverse charge (I4.r3)."]
} {
    object.get(input.invoice, "service_category", "") == "CONSTRUCTION"
    object.get(input.invoice, "building_type", "") != "RESIDENTIAL"
}

