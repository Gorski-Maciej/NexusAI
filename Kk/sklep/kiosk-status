#!/bin/bash
# kiosk-status - raport stanu kiosku (zadanie 23 z instrukcji)
# Instalacja: sudo cp kiosk-status /usr/local/bin/ && sudo chmod +x /usr/local/bin/kiosk-status
echo "=== Stan Kiosku $(date) ==="
echo ""
echo "--- Uslugi ---"
for svc in lightdm dnsmasq ssh kiosk-watchdog pm2-root; do
  status=$(systemctl is-active "$svc" 2>/dev/null || echo "brak")
  printf "  %-20s %s\n" "$svc:" "$status"
done
echo ""
echo "--- Sesja graficzna ---"
who | grep kiosk || echo "  (brak aktywnej sesji kiosk)"
echo ""
echo "--- Przegladarka ---"
pgrep -a chromium-browser | head -3 || echo "  (Chromium nie dziala)"
echo ""
echo "--- Sklep (PM2) ---"
command -v pm2 >/dev/null && pm2 list 2>/dev/null || sudo -u admin pm2 list 2>/dev/null || echo "  (pm2 niedostepny)"
echo ""
echo "--- DNS - ostatnie 10 zapytan ---"
tail -10 /var/log/dnsmasq.log 2>/dev/null | awk '{
  if ($0 ~ /NXDOMAIN/) print "  BLOK " $6
  else if ($0 ~ /forwarded/) print "  OK   " $5
}' || echo "  (brak logow)"
echo ""
echo "--- DNS - statystyki blokowania ---"
allowed=$(grep -c "forwarded" /var/log/dnsmasq.log 2>/dev/null || echo 0)
blocked=$(grep -c "NXDOMAIN" /var/log/dnsmasq.log 2>/dev/null || echo 0)
echo "  Dozwolone: $allowed   Zablokowane: $blocked"
