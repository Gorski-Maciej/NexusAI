{
  // ========================================================================
  //  VS Code: uruchamianie sklepu BEZ PISANIA KOMEND
  //  Terminal -> Uruchom zadanie kompilacji...  (Ctrl+Shift+B)
  // ========================================================================
  "version": "2.0.0",
  "tasks": [
    {
      "label": "URUCHOM SKLEP",
      "type": "shell",
      // npm start sam doinstalowuje biblioteki przy pierwszym starcie (prestart.js)
      // Celowo bez "&&" - PowerShell 5.1 (Windows 10) go nie obsluguje
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "STOP SKLEP",
      "type": "shell",
      "windows": {
        "command": "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort 3000 -State Listen | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force }\""
      },
      "linux": {
        "command": "bash -c 'pkill -f \"node server.js\" 2>/dev/null; sleep 1; pgrep -f \"node server.js\" >/dev/null && echo \"NIE udalo sie zatrzymac\" || echo \"Sklep zatrzymany.\"'"
      },
      "osx": {
      "command": "bash -c 'pkill -f \"node server.js\" 2>/dev/null; sleep 1; echo \"Sklep zatrzymany.\"'"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
