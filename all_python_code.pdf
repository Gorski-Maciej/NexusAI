1 0 0 1 40 375 Tm () Tj
1 0 0 1 40 364 Tm (# Very simple PDF writer using base14 Courier font) Tj
1 0 0 1 40 353 Tm (page_w, page_h = 612, 792) Tj
1 0 0 1 40 342 Tm (left, top, bottom = 40, 760, 40) Tj
1 0 0 1 40 331 Tm (font_size = 9) Tj
1 0 0 1 40 320 Tm (line_h = 11) Tj
1 0 0 1 40 309 Tm (max_lines = \(top - bottom\) // line_h) Tj
1 0 0 1 40 298 Tm () Tj
1 0 0 1 40 287 Tm (# escape PDF string chars) Tj
1 0 0 1 40 276 Tm () Tj
1 0 0 1 40 265 Tm (def esc\(s: str\) -> str:) Tj
1 0 0 1 40 254 Tm (    return s.replace\('\\\\', '\\\\\\\\'\).replace\('\(', '\\\\\('\).replace\('\)', '\\\\\)'\)) Tj
1 0 0 1 40 243 Tm () Tj
1 0 0 1 40 232 Tm (pages = []) Tj
1 0 0 1 40 221 Tm (for i in range\(0, len\(content_lines\), max_lines\):) Tj
1 0 0 1 40 210 Tm (    chunk = content_lines[i:i+max_lines]) Tj
1 0 0 1 40 199 Tm (    y = top) Tj
1 0 0 1 40 188 Tm (    cmds = ['BT', f'/F1 {font_size} Tf']) Tj
1 0 0 1 40 177 Tm (    for line in chunk:) Tj
1 0 0 1 40 166 Tm (        cmds.append\(f'1 0 0 1 {left} {y} Tm \({esc\(line\)[:180]}\) Tj'\)) Tj
1 0 0 1 40 155 Tm (        y -= line_h) Tj
1 0 0 1 40 144 Tm (    cmds.append\('ET'\)) Tj
1 0 0 1 40 133 Tm (    pages.append\('\\n'.join\(cmds\).encode\('latin-1', errors='replace'\)\)) Tj
1 0 0 1 40 122 Tm () Tj
1 0 0 1 40 111 Tm (objects = []) Tj
1 0 0 1 40 100 Tm () Tj
1 0 0 1 40 89 Tm (# 1: Catalog, 2: Pages, 3.. page objs + streams + font) Tj
1 0 0 1 40 78 Tm (font_obj_num = 3 + len\(pages\)*2) Tj
1 0 0 1 40 67 Tm () Tj
1 0 0 1 40 56 Tm (objects.append\(b'<< /Type /Catalog /Pages 2 0 R >>'\)) Tj
ET
endstream
