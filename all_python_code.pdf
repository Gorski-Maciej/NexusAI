1 0 0 1 40 562 Tm () Tj
1 0 0 1 40 551 Tm (    @staticmethod) Tj
1 0 0 1 40 540 Tm (    def enhance_for_ocr\(image_bytes: bytes\) -> bytes:) Tj
1 0 0 1 40 529 Tm (        """Zwi?ksza kontrast i usuwa szumy \(Denoising\).""") Tj
1 0 0 1 40 518 Tm (        try:) Tj
1 0 0 1 40 507 Tm (            nparr = np.frombuffer\(image_bytes, np.uint8\)) Tj
1 0 0 1 40 496 Tm (            img = cv2.imdecode\(nparr, cv2.IMREAD_GRAYSCALE\)) Tj
1 0 0 1 40 485 Tm () Tj
1 0 0 1 40 474 Tm (            # 1. Progowanie adaptacyjne \(Binarization\)) Tj
1 0 0 1 40 463 Tm (            thresh = cv2.adaptiveThreshold\() Tj
1 0 0 1 40 452 Tm (                img, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,) Tj
1 0 0 1 40 441 Tm (                cv2.THRESH_BINARY, 11, 2) Tj
1 0 0 1 40 430 Tm (            \)) Tj
1 0 0 1 40 419 Tm () Tj
1 0 0 1 40 408 Tm (            # 2. Usuwanie drobnych szumw) Tj
1 0 0 1 40 397 Tm (            kernel = np.ones\(\(1, 1\), np.uint8\)) Tj
1 0 0 1 40 386 Tm (            opening = cv2.morphologyEx\(thresh, cv2.MORPH_OPEN, kernel\)) Tj
1 0 0 1 40 375 Tm () Tj
1 0 0 1 40 364 Tm (            _, encoded_img = cv2.imencode\('.png', opening\)) Tj
1 0 0 1 40 353 Tm (            return encoded_img.tobytes\(\)) Tj
1 0 0 1 40 342 Tm (        except Exception as e:) Tj
1 0 0 1 40 331 Tm (            logger.error\(f"Image enhancement failed: {e}"\)) Tj
1 0 0 1 40 320 Tm (            return image_bytes) Tj
1 0 0 1 40 309 Tm () Tj
1 0 0 1 40 298 Tm (    @staticmethod) Tj
1 0 0 1 40 287 Tm (    def deskew\(image_bytes: bytes\) -> bytes:) Tj
1 0 0 1 40 276 Tm (        """Prostuje tekst, je?li dokument zosta? krzywo zeskanowany.""") Tj
1 0 0 1 40 265 Tm (        try:) Tj
1 0 0 1 40 254 Tm (            nparr = np.frombuffer\(image_bytes, np.uint8\)) Tj
1 0 0 1 40 243 Tm (            img = cv2.imdecode\(nparr, cv2.IMREAD_GRAYSCALE\)) Tj
1 0 0 1 40 232 Tm () Tj
1 0 0 1 40 221 Tm (            # Znajdowanie kraw?dzi i prostowanie) Tj
1 0 0 1 40 210 Tm (            coords = np.column_stack\(np.where\(img > 0\)\)) Tj
1 0 0 1 40 199 Tm (            angle = cv2.minAreaRect\(coords\)[-1]) Tj
1 0 0 1 40 188 Tm (            if angle < -45:) Tj
1 0 0 1 40 177 Tm (                angle = -\(90 + angle\)) Tj
1 0 0 1 40 166 Tm (            else:) Tj
1 0 0 1 40 155 Tm (                angle = -angle) Tj
1 0 0 1 40 144 Tm () Tj
1 0 0 1 40 133 Tm (            \(h, w\) = img.shape[:2]) Tj
1 0 0 1 40 122 Tm (            center = \(w // 2, h // 2\)) Tj
1 0 0 1 40 111 Tm (            M = cv2.getRotationMatrix2D\(center, angle, 1.0\)) Tj
1 0 0 1 40 100 Tm (            rotated = cv2.warpAffine\(img, M, \(w, h\), flags=cv2.INTER_CUBIC, borderMode=cv2.BORDER_REPLICATE\)) Tj
1 0 0 1 40 89 Tm () Tj
1 0 0 1 40 78 Tm (            _, encoded_img = cv2.imencode\('.png', rotated\)) Tj
1 0 0 1 40 67 Tm (            return encoded_img.tobytes\(\)) Tj
1 0 0 1 40 56 Tm (        except Exception as e:) Tj
ET
