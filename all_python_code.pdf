1 0 0 1 40 661 Tm () Tj
1 0 0 1 40 650 Tm (    @staticmethod) Tj
1 0 0 1 40 639 Tm (    def calculate_score\(data: dict, ocr_confidence: float\) -> float:) Tj
1 0 0 1 40 628 Tm (        """) Tj
1 0 0 1 40 617 Tm (        Ocena spjno?ci:) Tj
1 0 0 1 40 606 Tm (        - Czy wszystkie kluczowe pola s? obecne? \(+40%\)) Tj
1 0 0 1 40 595 Tm (        - Czy matematyka si? zgadza? \(+30%\)) Tj
1 0 0 1 40 584 Tm (        - Wynik OCR? \(+30%\)) Tj
1 0 0 1 40 573 Tm (        """) Tj
1 0 0 1 40 562 Tm (        score = 0.0) Tj
1 0 0 1 40 551 Tm (        required_fields = ["number", "contractor_nip", "amount_gross"]) Tj
1 0 0 1 40 540 Tm () Tj
1 0 0 1 40 529 Tm (        # 1. Sprawdzenie kompletno?ci) Tj
1 0 0 1 40 518 Tm (        found_fields = [f for f in required_fields if data.get\(f\)]) Tj
1 0 0 1 40 507 Tm (        score += \(len\(found_fields\) / len\(required_fields\)\) * 40) Tj
1 0 0 1 40 496 Tm () Tj
1 0 0 1 40 485 Tm (        # 2. Sprawdzenie matematyki) Tj
1 0 0 1 40 474 Tm (        try:) Tj
1 0 0 1 40 463 Tm (            net = Decimal\(str\(data.get\("amount_net", 0\)\)\)) Tj
1 0 0 1 40 452 Tm (            vat = Decimal\(str\(data.get\("amount_vat", 0\)\)\)) Tj
1 0 0 1 40 441 Tm (            gross = Decimal\(str\(data.get\("amount_gross", 0\)\)\)) Tj
1 0 0 1 40 430 Tm () Tj
1 0 0 1 40 419 Tm (            if gross > 0 and abs\(\(net + vat\) - gross\) < 0.05:) Tj
1 0 0 1 40 408 Tm (                score += 30) Tj
1 0 0 1 40 397 Tm (        except Exception:) Tj
1 0 0 1 40 386 Tm (            pass) Tj
1 0 0 1 40 375 Tm () Tj
1 0 0 1 40 364 Tm (        # 3. Zaufanie do modelu bazowego) Tj
1 0 0 1 40 353 Tm (        score += \(ocr_confidence * 30\)) Tj
1 0 0 1 40 342 Tm () Tj
1 0 0 1 40 331 Tm (        return min\(score, 100.0\)) Tj
1 0 0 1 40 320 Tm () Tj
