1 0 0 1 40 749 Tm (class AdaptiveBatcher:) Tj
1 0 0 1 40 738 Tm (    """Grupowanie zada? AI dla optymalnego wykorzystania przepustowo?ci GPU.""") Tj
1 0 0 1 40 727 Tm () Tj
1 0 0 1 40 716 Tm (    def __init__\(self, process_func, batch_size: int = 8, timeout: float = 0.2\):) Tj
1 0 0 1 40 705 Tm (        self.process_func = process_func # Funkcja inferencyjna modelu \(np. _infer_batch\)) Tj
1 0 0 1 40 694 Tm (        self.batch_size = batch_size # Maksymalny rozmiar batcha) Tj
1 0 0 1 40 683 Tm (        self.timeout = timeout # Maksymalny czas oczekiwania \(w sekundach\)) Tj
1 0 0 1 40 672 Tm (        self._queue = asyncio.Queue\(\)) Tj
1 0 0 1 40 661 Tm (        self._worker_task = asyncio.create_task\(self._batch_worker\(\)\)) Tj
1 0 0 1 40 650 Tm () Tj
1 0 0 1 40 639 Tm (    async def add_task\(self, item: Any\) -> Any:) Tj
1 0 0 1 40 628 Tm (        """Dodaje zadanie do kolejki i czeka na jego przetworzenie.""") Tj
1 0 0 1 40 617 Tm (        future = asyncio.get_event_loop\(\).create_future\(\)) Tj
1 0 0 1 40 606 Tm (        await self._queue.put\(\(item, future\)\)) Tj
1 0 0 1 40 595 Tm (        return await future) Tj
1 0 0 1 40 584 Tm () Tj
1 0 0 1 40 573 Tm (    async def _batch_worker\(self\):) Tj
1 0 0 1 40 562 Tm (        """W?tek roboczy grupuj?cy zadania.""") Tj
1 0 0 1 40 551 Tm (        while True:) Tj
1 0 0 1 40 540 Tm (            batch = []) Tj
1 0 0 1 40 529 Tm (            futures = []) Tj
1 0 0 1 40 518 Tm () Tj
1 0 0 1 40 507 Tm (            try:) Tj
1 0 0 1 40 496 Tm (                # Oczekiwanie na pierwszy element) Tj
1 0 0 1 40 485 Tm (                item, future = await self._queue.get\(\)) Tj
1 0 0 1 40 474 Tm (                batch.append\(item\)) Tj
1 0 0 1 40 463 Tm (                futures.append\(future\)) Tj
1 0 0 1 40 452 Tm () Tj
1 0 0 1 40 441 Tm (                # Zbieranie kolejnych do osi?gni?cia batch_size lub timeoutu) Tj
1 0 0 1 40 430 Tm (                end_time = asyncio.get_event_loop\(\).time\(\) + self.timeout) Tj
1 0 0 1 40 419 Tm (                while len\(batch\) < self.batch_size:) Tj
1 0 0 1 40 408 Tm (                    time_left = end_time - asyncio.get_event_loop\(\).time\(\)) Tj
1 0 0 1 40 397 Tm (                    if time_left <= 0:) Tj
1 0 0 1 40 386 Tm (                        break) Tj
1 0 0 1 40 375 Tm (                    try:) Tj
1 0 0 1 40 364 Tm (                        item, future = await asyncio.wait_for\(self._queue.get\(\), timeout=time_left\)) Tj
1 0 0 1 40 353 Tm (                        batch.append\(item\)) Tj
1 0 0 1 40 342 Tm (                        futures.append\(future\)) Tj
1 0 0 1 40 331 Tm (                    except asyncio.TimeoutError:) Tj
1 0 0 1 40 320 Tm (                        break) Tj
1 0 0 1 40 309 Tm () Tj
1 0 0 1 40 298 Tm (                if batch:) Tj
1 0 0 1 40 287 Tm (                    logger.debug\(f"Wysy?anie batcha {len\(batch\)} elementw do GPU..."\)) Tj
1 0 0 1 40 276 Tm (                    results = await self.process_func\(batch\)) Tj
1 0 0 1 40 265 Tm () Tj
1 0 0 1 40 254 Tm (                    # Rozdanie wynikw do oczekuj?cych w?tkw) Tj
1 0 0 1 40 243 Tm (                    for fut, res in zip\(futures, results\):) Tj
1 0 0 1 40 232 Tm (                        if not fut.done\(\):) Tj
1 0 0 1 40 221 Tm (                            fut.set_result\(res\)) Tj
1 0 0 1 40 210 Tm () Tj
1 0 0 1 40 199 Tm (            except Exception as e:) Tj
1 0 0 1 40 188 Tm (                logger.error\(f"B??d przetwarzania batcha: {e}"\)) Tj
1 0 0 1 40 177 Tm (                for fut in futures:) Tj
1 0 0 1 40 166 Tm (                    if not fut.done\(\):) Tj
1 0 0 1 40 155 Tm (                        fut.set_exception\(e\)) Tj
1 0 0 1 40 144 Tm () Tj
