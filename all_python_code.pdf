1 0 0 1 40 397 Tm (    """) Tj
1 0 0 1 40 386 Tm (    Dekorator ponawiaj?cy wykonanie asynchronicznej funkcji w przypadku b??du.) Tj
1 0 0 1 40 375 Tm (    U?ywa strategii Exponential Backoff \(1s, 2s, 4s...\).) Tj
1 0 0 1 40 364 Tm (    """) Tj
1 0 0 1 40 353 Tm (    def decorator\(func: Callable\) -> Callable:) Tj
1 0 0 1 40 342 Tm (        @wraps\(func\)) Tj
1 0 0 1 40 331 Tm (        async def wrapper\(*args, **kwargs\) -> Any:) Tj
1 0 0 1 40 320 Tm (            retries = 0) Tj
1 0 0 1 40 309 Tm (            delay = base_delay) Tj
1 0 0 1 40 298 Tm (            while True:) Tj
1 0 0 1 40 287 Tm (                try:) Tj
1 0 0 1 40 276 Tm (                    return await func\(*args, **kwargs\)) Tj
1 0 0 1 40 265 Tm (                except exceptions as e:) Tj
1 0 0 1 40 254 Tm (                    retries += 1) Tj
1 0 0 1 40 243 Tm (                    if retries > max_retries:) Tj
1 0 0 1 40 232 Tm (                        logger.error\(f"Przekroczono limit prb \({max_retries}\) dla {func.__name__}. B??d: {e}"\)) Tj
1 0 0 1 40 221 Tm (                        raise) Tj
1 0 0 1 40 210 Tm (                    logger.warning\(f"B??d w {func.__name__}: {e}. Ponawianie za {delay}s..."\)) Tj
1 0 0 1 40 199 Tm (                    await asyncio.sleep\(delay\)) Tj
1 0 0 1 40 188 Tm (                    delay = min\(delay * 2, max_delay\)) Tj
1 0 0 1 40 177 Tm (        return wrapper) Tj
1 0 0 1 40 166 Tm (    return decorator) Tj
