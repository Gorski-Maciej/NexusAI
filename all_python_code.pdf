1 0 0 1 40 331 Tm () Tj
1 0 0 1 40 320 Tm (    def ask\(self, question: str, top_k: int = 5\) -> RAGAnswer:) Tj
1 0 0 1 40 309 Tm (        q_vector = self.embedder.encode\(question\)) Tj
1 0 0 1 40 298 Tm (        hits = self.vector_store.search\(q_vector, top_k=top_k\)) Tj
1 0 0 1 40 287 Tm (        context = "\\n".join\(hit["chunk"] for hit in hits\)) Tj
1 0 0 1 40 276 Tm (        prompt = \() Tj
1 0 0 1 40 265 Tm (            "Jeste? lokalnym CFO copilotem. Odpowiadaj po polsku, precyzyjnie i z uzasadnieniem.\\n") Tj
1 0 0 1 40 254 Tm (            f"Pytanie: {question}\\n") Tj
1 0 0 1 40 243 Tm (            f"Kontekst:\\n{context}") Tj
1 0 0 1 40 232 Tm (        \)) Tj
1 0 0 1 40 221 Tm (        answer = self.llm_client.generate\(prompt\)) Tj
1 0 0 1 40 210 Tm (        chart_spec = _build_chart_from_hits\(hits\)) Tj
1 0 0 1 40 199 Tm (        return RAGAnswer\(answer=answer, evidence_chunks=[h["chunk"] for h in hits], chart_spec=chart_spec\)) Tj
