1 0 0 1 40 705 Tm () Tj
1 0 0 1 40 694 Tm (    def truncate_for_llm\(self, text: str, reserve_tokens: int = 500\) -> str:) Tj
1 0 0 1 40 683 Tm (        """Przycina tekst OCR, aby zmie?ci? si? w oknie modelu wraz z promptem.""") Tj
1 0 0 1 40 672 Tm (        max_chars = \(self.max_tokens - reserve_tokens\) * self.chars_per_token) Tj
1 0 0 1 40 661 Tm () Tj
1 0 0 1 40 650 Tm (        if len\(text\) > max_chars:) Tj
1 0 0 1 40 639 Tm (            logger.warning\(f"Tekst dokumentu zbyt d?ugi \({len\(text\)} znakw\). Przycinanie do {max_chars}."\)) Tj
1 0 0 1 40 628 Tm (            # Przycinamy do ostatniej kropki, aby nie rwa? zda?) Tj
1 0 0 1 40 617 Tm (            truncated = text[:max_chars]) Tj
1 0 0 1 40 606 Tm (            last_dot = truncated.rfind\('.'\)) Tj
1 0 0 1 40 595 Tm (            return truncated[:last_dot + 1] if last_dot > 0 else truncated) Tj
1 0 0 1 40 584 Tm () Tj
1 0 0 1 40 573 Tm (        return text) Tj
