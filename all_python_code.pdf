1 0 0 1 40 474 Tm (        target = [core for core in available if core != 0] or available) Tj
1 0 0 1 40 463 Tm (    else:) Tj
1 0 0 1 40 452 Tm (        target = available) Tj
1 0 0 1 40 441 Tm (    process.cpu_affinity\(target\)) Tj
