1 0 0 1 40 507 Tm () Tj
1 0 0 1 40 496 Tm (def get_cashflow_forecast\(db_path: str = "data/nexus_analytics.duckdb"\) -> pd.DataFrame:) Tj
1 0 0 1 40 485 Tm (    conn = duckdb.connect\(db_path\)) Tj
1 0 0 1 40 474 Tm (    # Zapytanie: sumujemy przychody i koszty po dacie p?atno?ci \(due_date\) i obliczamy skumulowane saldo \(CASHFLOW\)) Tj
1 0 0 1 40 463 Tm (    query = """) Tj
1 0 0 1 40 452 Tm (    WITH DailyFlows AS \() Tj
1 0 0 1 40 441 Tm (        SELECT) Tj
1 0 0 1 40 430 Tm (            due_date,) Tj
1 0 0 1 40 419 Tm (            SUM\(CASE WHEN type = 'SALE' THEN amount_gross ELSE 0 END\) as daily_in,) Tj
1 0 0 1 40 408 Tm (            SUM\(CASE WHEN type = 'COST' THEN amount_gross ELSE 0 END\) as daily_out) Tj
1 0 0 1 40 397 Tm (        FROM invoices) Tj
1 0 0 1 40 386 Tm (        WHERE due_date >= CURRENT_DATE ) Tj
1 0 0 1 40 375 Tm (          AND due_date <= CURRENT_DATE + INTERVAL 30 DAY) Tj
1 0 0 1 40 364 Tm (        GROUP BY due_date) Tj
1 0 0 1 40 353 Tm (    \)) Tj
1 0 0 1 40 342 Tm (    SELECT) Tj
1 0 0 1 40 331 Tm (        due_date,) Tj
1 0 0 1 40 320 Tm (        daily_in,) Tj
1 0 0 1 40 309 Tm (        daily_out,) Tj
1 0 0 1 40 298 Tm (        SUM\(daily_in - daily_out\) OVER \(ORDER BY due_date ASC\) as projected_balance) Tj
1 0 0 1 40 287 Tm (    FROM DailyFlows) Tj
1 0 0 1 40 276 Tm (    ORDER BY due_date;) Tj
1 0 0 1 40 265 Tm (    """) Tj
1 0 0 1 40 254 Tm (    df = conn.execute\(query\).df\(\)) Tj
1 0 0 1 40 243 Tm (    conn.close\(\)) Tj
1 0 0 1 40 232 Tm (    return df) Tj
