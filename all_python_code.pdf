1 0 0 1 40 529 Tm (def pin_worker_cpu_affinity\(reserve_core0: bool = True\) -> None:) Tj
1 0 0 1 40 518 Tm (    """Pin worker process to non-UI CPU cores to protect Flet responsiveness.""") Tj
1 0 0 1 40 507 Tm (    process = psutil.Process\(\)) Tj
