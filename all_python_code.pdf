1 0 0 1 40 210 Tm (            self._on_success\(\)) Tj
1 0 0 1 40 199 Tm (            return result) Tj
1 0 0 1 40 188 Tm (        except Exception as e:) Tj
1 0 0 1 40 177 Tm (            self._on_failure\(\)) Tj
1 0 0 1 40 166 Tm (            raise e) Tj
1 0 0 1 40 155 Tm () Tj
1 0 0 1 40 144 Tm (    def _on_success\(self\):) Tj
1 0 0 1 40 133 Tm (        self.failures = 0) Tj
1 0 0 1 40 122 Tm (        self.state = CircuitState.CLOSED) Tj
1 0 0 1 40 111 Tm (        ) Tj
1 0 0 1 40 100 Tm (    def _on_failure\(self\):) Tj
1 0 0 1 40 89 Tm (        self.failures += 1) Tj
1 0 0 1 40 78 Tm (        self.last_failure_time = time.time\(\)) Tj
1 0 0 1 40 67 Tm (        if self.failures >= self.failure_threshold:) Tj
1 0 0 1 40 56 Tm (            self.state = CircuitState.OPEN) Tj
