1 0 0 1 40 529 Tm (    def forecast\(self, horizon_days: int = 60\) -> dict[str, Any]:) Tj
1 0 0 1 40 518 Tm (        query = f""") Tj
1 0 0 1 40 507 Tm (        WITH future_liabilities AS \() Tj
1 0 0 1 40 496 Tm (            SELECT due_date::DATE AS day, SUM\(amount_gross\) AS outgoing) Tj
1 0 0 1 40 485 Tm (            FROM invoices_replica) Tj
1 0 0 1 40 474 Tm (            WHERE status IN \('APPROVED', 'AUTO_APPROVED'\)) Tj
1 0 0 1 40 463 Tm (              AND paid_at IS NULL) Tj
1 0 0 1 40 452 Tm (              AND due_date BETWEEN CURRENT_DATE AND CURRENT_DATE + INTERVAL {horizon_days} DAY) Tj
1 0 0 1 40 441 Tm (            GROUP BY 1) Tj
1 0 0 1 40 430 Tm (        \),) Tj
1 0 0 1 40 419 Tm (        rolling AS \() Tj
1 0 0 1 40 408 Tm (            SELECT day,) Tj
1 0 0 1 40 397 Tm (                   outgoing,) Tj
1 0 0 1 40 386 Tm (                   SUM\(outgoing\) OVER \(ORDER BY day ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\) AS cum_outgoing) Tj
1 0 0 1 40 375 Tm (            FROM future_liabilities) Tj
1 0 0 1 40 364 Tm (        \)) Tj
1 0 0 1 40 353 Tm (        SELECT * FROM rolling ORDER BY day;) Tj
1 0 0 1 40 342 Tm (        """) Tj
1 0 0 1 40 331 Tm (        series = self.duckdb.execute\(query\).fetchall\(\)) Tj
1 0 0 1 40 320 Tm () Tj
1 0 0 1 40 309 Tm (        min_balance = _estimate_min_balance\(series\)) Tj
1 0 0 1 40 298 Tm (        alerts: list[str] = []) Tj
1 0 0 1 40 287 Tm (        if min_balance < 0:) Tj
1 0 0 1 40 276 Tm (            alerts.append\(f"Prognozowany niedobr ?rodkw: {abs\(min_balance\):,.2f} PLN"\)) Tj
1 0 0 1 40 265 Tm () Tj
1 0 0 1 40 254 Tm (        return {"series": series, "min_balance": min_balance, "alerts": alerts}) Tj
1 0 0 1 40 243 Tm () Tj
