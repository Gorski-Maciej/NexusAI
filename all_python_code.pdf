1 0 0 1 40 287 Tm (            if time.time\(\) - self.last_failure_time > self.recovery_timeout:) Tj
1 0 0 1 40 276 Tm (                self.state = CircuitState.HALF_OPEN) Tj
1 0 0 1 40 265 Tm (            else:) Tj
1 0 0 1 40 254 Tm (                raise Exception\("KSeF API jest obecnie niedost?pne \(Circuit Breaker OPEN\)"\)) Tj
1 0 0 1 40 243 Tm () Tj
1 0 0 1 40 232 Tm (        try:) Tj
