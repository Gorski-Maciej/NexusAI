1 0 0 1 40 276 Tm () Tj
1 0 0 1 40 265 Tm (    def check_resources\(self\) -> bool:) Tj
1 0 0 1 40 254 Tm (        current_mem = self.process.memory_info\(\).rss) Tj
1 0 0 1 40 243 Tm (        if current_mem <= self.ram_limit:) Tj
1 0 0 1 40 232 Tm (            return False) Tj
1 0 0 1 40 221 Tm () Tj
1 0 0 1 40 210 Tm (        logger.warning\("RAM alert: %.1f MB. Triggering cleanup...", current_mem / 1024**2\)) Tj
1 0 0 1 40 199 Tm (        if torch is not None and torch.cuda.is_available\(\):) Tj
1 0 0 1 40 188 Tm (            torch.cuda.empty_cache\(\)) Tj
1 0 0 1 40 177 Tm (        gc.collect\(\)) Tj
1 0 0 1 40 166 Tm (        return True) Tj
1 0 0 1 40 155 Tm () Tj
1 0 0 1 40 144 Tm (    async def heartbeat\(self\) -> None:) Tj
1 0 0 1 40 133 Tm (        while True:) Tj
1 0 0 1 40 122 Tm (            uptime = datetime.now\(timezone.utc\) - self.start_time) Tj
1 0 0 1 40 111 Tm (            ram_mb = self.process.memory_info\(\).rss / 1024**2) Tj
1 0 0 1 40 100 Tm (            logger.debug\("Heartbeat uptime=%s RAM=%.1fMB", uptime, ram_mb\)) Tj
1 0 0 1 40 89 Tm (            await asyncio.sleep\(60\)) Tj
1 0 0 1 40 78 Tm () Tj
1 0 0 1 40 67 Tm () Tj
