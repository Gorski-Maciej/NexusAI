# ═══════════════════════════════════════════════════════════════════════════════════
# NexusAI — plik .env.example
# ═══════════════════════════════════════════════════════════════════════════════════
# Skopiuj ten plik jako .env i dostosuj wartości do swojego środowiska.
#   cp .env.example .env
#
# UWAGA: pixi automatycznie ustawia zmienne z [activation.env] w pixi.toml.
# Ten plik jest używany tylko jeśli uruchamiasz aplikację POZA środowiskiem pixi.
# W trybie pixi, zmienne środowiskowe są zdefiniowane w pixi.toml.
# ═══════════════════════════════════════════════════════════════════════════════════

# ── Podstawowa konfiguracja aplikacji ──────────────────────────────────────────
NEXUS_LOG_LEVEL=info
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8000
NEXUS_DB_PATH=app_data/nexus.db
NEXUS_UNIX_SOCKET=/tmp/nexus-api.sock
NEXUS_WATCH_INTERVAL=5

# ── Granian (serwer ASGI w Rust) ──────────────────────────────────────────────
NEXUS_GRANIAN_BACKLOG=2048
NEXUS_GRANIAN_BACKPRESSURE=100
NEXUS_GRANIAN_HTTP=auto
NEXUS_GRANIAN_WORKERS=1
NEXUS_GRANIAN_RUNTIME_THREADS=2
NEXUS_GRANIAN_BLOCKING_THREADS=4
NEXUS_GRANIAN_METRICS=true
NEXUS_GRANIAN_METRICS_ADDRESS=127.0.0.1
NEXUS_GRANIAN_METRICS_PORT=9090
NEXUS_GRANIAN_RESPAWN=true
NEXUS_GRANIAN_GRACEFUL_SHUTDOWN=30
NEXUS_GRANIAN_PID_FILE=/tmp/nexus-api.pid
NEXUS_GRANIAN_WORKER_MAX_RSS=0
NEXUS_GRANIAN_WORKER_LIFETIME=0
NEXUS_GRANIAN_NO_SERVER_HEADER=true
NEXUS_GRANIAN_ACCESS_LOG=true
NEXUS_GRANIAN_PROCESS_NAME=nexus-api
NEXUS_GRANIAN_HTTP2_MAX_STREAMS=256
NEXUS_GRANIAN_LOOP=auto

# ── NATS JetStream (broker wiadomości) ────────────────────────────────────────
NEXUS_NATS_URL=nats://127.0.0.1:4222
NEXUS_NATS_CREDS_FILE=

# ── TigerBeetle (double-entry ledger) ──────────────────────────────────────────
NEXUS_TB_ADDRESS=/tmp/nexus-tb.sock
NEXUS_TB_CLUSTER=0

# ── OPA (Open Policy Agent — silnik reguł) ───────────────────────────────────
NEXUS_OPA_URL=http://localhost:8181

# ── KSeF (Krajowy System e-Faktur) ────────────────────────────────────────────
NEXUS_KSEF_API_URL=https://ksef.mf.gov.pl/api/
NEXUS_KSEF_TOKEN=
NEXUS_KSEF_NIP=

# ── Integracje zewnętrzne ─────────────────────────────────────────────────────
NEXUS_NBP_API_URL=https://api.nbp.pl/api/exchangerates/rates/a/
NEXUS_GUS_API_URL=https://wyszukiwarka.ceidg.gov.pl/CEIDG
NEXUS_WHITE_LIST_API_URL=https://wl-api.mf.gov.pl/api/

# ── Bezpieczeństwo ────────────────────────────────────────────────────────────
NEXUS_JWT_SECRET=
NEXUS_JWT_EXPIRY=900
NEXUS_REFRESH_EXPIRY=604800
NEXUS_CSRF_ENABLED=true
NEXUS_PASSWORD_MIN_LENGTH=12
NEXUS_ARGON2_MEMORY_KB=65536
NEXUS_ARGON2_ITERATIONS=3
NEXUS_ARGON2_PARALLELISM=4

# ── AI / Modele ───────────────────────────────────────────────────────────────
NEXUS_MODELS_DIR=models/
NEXUS_LLM_THREADS=4
NEXUS_LLM_GPU_LAYERS=0
NEXUS_LLM_RAM_LIMIT_MB=0

# ── RODO / Retencja danych ────────────────────────────────────────────────────
NEXUS_RETENTION_YEARS=5
NEXUS_LOG_PII_MASK=true

# ── Backup ────────────────────────────────────────────────────────────────────
NEXUS_BACKUP_DIR=app_data/backups
NEXUS_BACKUP_INTERVAL_MINUTES=1440
NEXUS_BACKUP_MAX_COUNT=30

# ── Monitoring / OpenTelemetry ────────────────────────────────────────────────
NEXUS_SENTRY_DSN=
NEXUS_OTEL_OFFLINE=true
NEXUS_OTEL_OTLP_ENDPOINT=

# ── Development-only ──────────────────────────────────────────────────────────
NEXUS_OPENAPI_ENABLED=true
NEXUS_DEV_ALLOW_INSECURE=0
NEXUS_DEBUG=false
