# =============================================================================
# .env.example — wszystkie zmienne środowiskowe NexusAI
# =============================================================================
# Skopiuj ten plik jako .env i dostosuj wartości do swojego środowiska.
#   cp .env.example .env
#
# UWAGA: pixi automatycznie ustawia część zmiennych z pixi.toml [activation.env].
# Zmienne z .env nadpisują te z pixi, jeśli mają wyższy priorytet.
# =============================================================================

# ── Podstawowa konfiguracja ──────────────────────────────────────────────────
NEXUS_LOG_LEVEL=info              # debug|info|warn|error
NEXUS_HOST=127.0.0.1              # Adres nasłuchiwania API
NEXUS_PORT=8000                   # Port API
NEXUS_DB_PATH=app_data/nexus.db   # Ścieżka do bazy SQLite
NEXUS_UNIX_SOCKET=/tmp/nexus-api.sock  # UNIX socket (szybszy niż TCP)
NEXUS_WATCH_INTERVAL=5            # Interwał monitorowania zmian (sekundy)

# ── Granian (serwer ASGI) ───────────────────────────────────────────────────
NEXUS_GRANIAN_BACKLOG=2048        # Kolejka połączeń
NEXUS_GRANIAN_BACKPRESSURE=100    # Limit równoczesnych żądań
NEXUS_GRANIAN_HTTP=auto           # HTTP/1 lub HTTP/2 (auto-wykrywanie)
NEXUS_GRANIAN_HTTP2_MAX_STREAMS=256  # Max strumieni HTTP/2
NEXUS_GRANIAN_WORKERS=1           # Liczba workerów (1=desktop, 4=prod)
NEXUS_GRANIAN_WORKER_MAX_RSS=1024 # Max RSS na workera (MB)
NEXUS_GRANIAN_WORKER_LIFETIME=86400  # Czas życia workera (sekundy)
NEXUS_GRANIAN_RUNTIME_THREADS=2   # Wątki runtime
NEXUS_GRANIAN_RUNTIME_BLOCKING_THREADS=4  # Wątki blokujące
NEXUS_GRANIAN_LOOP=auto           # Pętla zdarzeń: auto|uvloop|asyncio
NEXUS_GRANIAN_METRICS=true        # Włącz metryki Prometheus
NEXUS_GRANIAN_METRICS_ADDRESS=127.0.0.1
NEXUS_GRANIAN_METRICS_PORT=9090
NEXUS_GRANIAN_ACCESS_LOG=true     # Logowanie dostępu HTTP
NEXUS_GRANIAN_NO_SERVER_HEADER=true  # Ukryj nagłówek Server
NEXUS_GRANIAN_RESPAWN=true        # Automatyczny restart workera
NEXUS_GRANIAN_RESPAWN_MAX_TRIES=5  # Max prób restartu
NEXUS_GRANIAN_GRACEFUL_SHUTDOWN=30  # Czas na graceful shutdown (sekundy)
NEXUS_GRANIAN_PID_FILE=/tmp/nexus-api.pid  # Plik PID
NEXUS_GRANIAN_PROCESS_NAME=nexus-api      # Nazwa procesu

# ── NATS JetStream ──────────────────────────────────────────────────────────
NEXUS_NATS_URL=nats://127.0.0.1:4222
NEXUS_NATS_CREDS_FILE=            # Plik credentials (opcjonalnie)

# ── TigerBeetle (double-entry ledger) ───────────────────────────────────────
NEXUS_TB_ADDRESS=/tmp/nexus-tb.sock  # UNIX socket
NEXUS_TB_CLUSTER=0                # ID klastra (0 dla single-node)

# ── KSeF (Krajowy System e-Faktur) ──────────────────────────────────────────
NEXUS_KSEF_API_URL=https://ksef.mf.gov.pl/api/
NEXUS_KSEF_TOKEN=                 # Token API KSeF (z panelu MF)
NEXUS_KSEF_NIP=                   # NIP firmy dla KSeF

# ── Integracje zewnętrzne ───────────────────────────────────────────────────
NEXUS_NBP_API_URL=https://api.nbp.pl/api/exchangerates/rates/a/
NEXUS_GUS_API_URL=https://wyszukiwarka.ceidg.gov.pl/CEIDG
NEXUS_WHITE_LIST_API_URL=https://wl-api.mf.gov.pl/api/

# ── Bezpieczeństwo ──────────────────────────────────────────────────────────
NEXUS_JWT_SECRET=                 # Auto-generowany przy pierwszym starcie
NEXUS_JWT_EXPIRY=900             # TTL access token (sekundy, 900=15min)
NEXUS_REFRESH_EXPIRY=604800      # TTL refresh token (7 dni)
NEXUS_CSRF_ENABLED=true          # Włącz CSRF protection
NEXUS_PASSWORD_MIN_LENGTH=12     # Minimalna długość hasła
NEXUS_ARGON2_MEMORY_KB=65536     # Argon2id memory cost (64 MB)
NEXUS_ARGON2_ITERATIONS=3        # Argon2id iteracje

# ── AI / Modele ─────────────────────────────────────────────────────────────
NEXUS_MODELS_DIR=models/         # Katalog z modelami GGUF
NEXUS_LLM_THREADS=4             # Liczba wątków dla llama.cpp
NEXUS_LLM_GPU_LAYERS=0          # Warstwy GPU (0=CPU only)
NEXUS_LLM_CTX_SIZE=4096         # Rozmiar kontekstu (tokeny)

# ── RODO / Retencja ─────────────────────────────────────────────────────────
NEXUS_RETENTION_YEARS=5          # Domyślny okres przechowywania
NEXUS_LOG_PII_MASK=true          # Maskowanie PII w logach

# ── DuckDB (OLAP) ───────────────────────────────────────────────────────────
NEXUS_DUCKDB_PATH=app_data/analytics.duckdb  # Ścieżka do pliku DuckDB
NEXUS_DUCKDB_MEMORY_LIMIT=512MB  # Limit RAM dla DuckDB
NEXUS_DUCKDB_THREADS=2           # Liczba wątków

# ── Sentry (error tracking) ─────────────────────────────────────────────────
NEXUS_SENTRY_DSN=                # DSN Sentry (opcjonalnie)
NEXUS_SENTRY_ENVIRONMENT=development  # dev|staging|production
NEXUS_SENTRY_TRACES_SAMPLE_RATE=0.1  # Próbkowanie tracingu (0.0-1.0)

# ── OpenTelemetry ───────────────────────────────────────────────────────────
NEXUS_OTEL_ENABLED=false         # Włącz eksport OTel (true w produkcji)
NEXUS_OTEL_EXPORTER_ENDPOINT=http://localhost:4317  # OTLP endpoint

# ── OPA (Open Policy Agent) ─────────────────────────────────────────────────
NEXUS_OPA_URL=http://localhost:8181  # Adres serwera OPA
NEXUS_OPA_TIMEOUT=5              # Timeout zapytań OPA (sekundy)

# ── Flet UI ─────────────────────────────────────────────────────────────────
NEXUS_FLET_PORT=8001             # Port dla Flet UI (jeśli osobny)
NEXUS_FLET_THEME=dark            # Motyw: dark|light|system
