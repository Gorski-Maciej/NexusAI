#!/bin/bash
set -euo pipefail

REPO_DIR="/termux-home/NexusAI"
BRANCH="main"
COMMIT_MSG_PREFIX="Freebuff: auto-commit"

# Kolory
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

cd "$REPO_DIR"

# Funkcja do commitowania lokalnych zmian
commit_local_changes() {
    if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
        echo -e "${YELLOW}📦 Niezapisane zmiany – zatwierdzam...${NC}"
        git add .
        local TS
        TS=$(date +"%Y-%m-%d %H:%M:%S")
        git commit -m "${COMMIT_MSG_PREFIX} [${TS}]" || echo -e "${YELLOW}⚠️  Commit zbędny (brak zmian)${NC}"
    else
        echo -e "${GREEN}✅ Katalog roboczy czysty.${NC}"
    fi
}

# Funkcja do synchronizacji z GitHubem
sync_with_github() {
    echo -e "${YELLOW}🔄 Pobieram zmiany z GitHuba...${NC}"
    if ! git pull origin "$BRANCH" --rebase; then
        echo -e "${RED}❌ Konflikt! Rozwiązuję automatycznie...${NC}"
        git rebase --abort 2>/dev/null || true
        if ! git pull origin "$BRANCH" --no-rebase; then
            echo -e "${RED}💥 Nadal konflikt – zachowuję wersję lokalną.${NC}"
            git checkout --ours .
            git add .
            git commit -m "Merge: rozwiązanie konfliktu (zachowane zmiany lokalne)" || true
        fi
    fi
    echo -e "${YELLOW}📤 Wypycham na GitHub...${NC}"
    git push origin "$BRANCH"
    echo -e "${GREEN}✅ Zmiany na GitHubie.${NC}"
}

# Przechwycenie Ctrl+C
trap 'echo -e "\n${YELLOW}⚠️  Przerwano. Zapisuję i synchronizuję...${NC}"; commit_local_changes; sync_with_github; exit 130' INT TERM

echo -e "${GREEN}🚀 Uruchamiam Freebuff...${NC}"
freebuff

# Normalne zakończenie
commit_local_changes
sync_with_github
