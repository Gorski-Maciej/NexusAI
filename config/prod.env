# =============================================================================
# NexusAI — Production Environment Profile (config/prod.env)
# =============================================================================
# Auto-loaded when NEXUS_ENV=prod.
# Hardened security, minimal logging, strict limits, and production-safe defaults.
#
# IMPORTANT: The following secrets MUST be set via environment variables or
# Infiscal secrets manager (not in this file):
#   - NEXUS_JWT_SECRET
#   - NEXUS_ENCRYPTION_KEY
#   - NEXUS_ADMIN_PASSWORD

# ── Core ──────────────────────────────────────────────────────────────────────
NEXUS_DEBUG=0
NEXUS_LOG_LEVEL=warning
NEXUS_HOST=0.0.0.0
NEXUS_PORT=8000

# ── Security (production: short expiry, strict CORS, CSRF enforced) ──────────
NEXUS_JWT_EXPIRATION_SECONDS=900
NEXUS_REFRESH_TOKEN_DAYS=7
NEXUS_JWT_ISSUER=nexus-ai-prod
NEXUS_JWT_AUDIENCE=nexus-api-prod
# WARNING: CORS_ORIGINS MUST be set to a specific domain in production!
# Example: NEXUS_CORS_ORIGINS=https://app.example.com
NEXUS_CORS_ORIGINS=*                    # ← CHANGE THIS TO YOUR DOMAIN
NEXUS_CSRF_ENABLED=1                    # Enforce CSRF protection

# ── Database ──────────────────────────────────────────────────────────────────
NEXUS_SQLITE_FILE=nexus_oltp.db
NEXUS_DUCKDB_FILE=nexus_olap.duckdb
NEXUS_DUCKDB_MEMORY_LIMIT=4GB           # Increase for production OLAP queries
NEXUS_DUCKDB_THREADS=4                  # More parallel processing
NEXUS_IDEMPOTENCY_DB=idempotency.sqlite

# ── NATS (Message Broker) ────────────────────────────────────────────────────
NEXUS_NATS_URL=nats://nats:4222          # Docker compose service name
NEXUS_MAX_PARALLEL_OCR=3                # More concurrent OCR workers
NEXUS_OCR_TIMEOUT_SEC=600               # Longer timeout for complex documents
NEXUS_MODEL_CACHE_TTL_SEC=3600          # Cache models for 1 hour
NEXUS_OUTBOX_REPLAY_LIMIT=500

# ── Storage & Uploads (higher limits for production) ─────────────────────────
NEXUS_STORAGE_DIR=app_data/uploads
NEXUS_MAX_INVOICE_UPLOAD_MB=100         # Up to 100 MB invoices
NEXUS_MAX_ATTACHMENT_UPLOAD_MB=1000     # Up to 1 GB attachments

# ── TigerBeetle ───────────────────────────────────────────────────────────────
TB_CLUSTER_ID=0
TB_REPLICA_ADDRESSES=tigerbeetle:3000    # Docker compose service name

# ── AI Model Paths ────────────────────────────────────────────────────────────
NEXUS_COUNCIL_ALPHA_MODEL=models/LFM2.5-1.2B-Q4_K_M.gguf
NEXUS_COUNCIL_BETA_MODEL=models/Qwen3-0.6B-Q4_K_M.gguf
NEXUS_COUNCIL_GAMMA_MODEL=models/LittleLamb-0.3B-Q4_K_M.gguf
NEXUS_RULES_MODEL=models/granite-4.0-1b-nano-Q4_K_M.gguf
NEXUS_ANALYTICS_MODEL=models/qwen2.5-1.5b-instruct-Q4_K_M.gguf
NEXUS_FIN_DETECTIVE_MODEL=models/fin-rwkv-169m.pth
NEXUS_DECISION_JAMBA_MODEL=models/Jamba-Reasoning-3B-Q4_K_M.gguf
NEXUS_DECISION_GRANITE_MODEL=models/granite-4.0-1b-nano-Q4_K_M.gguf
NEXUS_ORCHESTRATOR_MODEL=models/LittleLamb-0.3B-Q4_K_M.gguf

# ── Decision Thresholds ───────────────────────────────────────────────────────
NEXUS_AUTOPILOT_AUTO_POST=0.95          # Higher threshold for auto-posting
NEXUS_AUTOPILOT_SUGGEST=0.80
NEXUS_AUTOPILOT_ASK=0.55
NEXUS_AUTOPILOT_ADAPTATION=0            # Disable runtime adaptation in prod
NEXUS_AUTOPILOT_LEARNING_RATE=0.05
NEXUS_AUTOPILOT_LOW_AMOUNT=500.0
NEXUS_AUTOPILOT_MODEL_TTL=3600          # Cache models for 1 hour
NEXUS_AUTOPILOT_AGENT_TIMEOUT=60
NEXUS_AUTOPILOT_VENDOR_ALPHA_MIN=3

# ── Rules Agent (stricter limits in production) ──────────────────────────────
NEXUS_RULES_MAX_AMOUNT=50000.0          # Lower auto-approve limit in prod
NEXUS_RULES_REQUIRE_NIP=1               # Always validate NIP

# ── Analytics ─────────────────────────────────────────────────────────────────
NEXUS_ANALYTICS_ANOMALY_THRESHOLD=2.5   # Slightly higher threshold (fewer false positives)
NEXUS_DECISION_TIMEOUT=120

# ── OpenTelemetry / Monitoring ────────────────────────────────────────────────
NEXUS_SENTRY_DSN=                       # ← Set your Sentry DSN here
NEXUS_DPO_ALERT_WEBHOOK=               # ← Set your DPO webhook URL here
NEXUS_OTEL_BUFFER_MAX_RECORDS=50000
NEXUS_SECURITY_SCAN_TIMEOUT_SEC=1800
NEXUS_PERF_K6_TIMEOUT_SEC=3600
