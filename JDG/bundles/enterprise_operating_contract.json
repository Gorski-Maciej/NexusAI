      "id": "G01_CONTRACT_SCHEMA",
      "description": "Kontrakt i raport mają wymagane pola i sekcje.",
      "on_fail": "BLOCK"
    },
    {
      "id": "G02_SOURCE_INVENTORY",
      "description": "Święte źródła architektury, rules, tests, migrations, bundles i policies istnieją.",
      "on_fail": "BLOCK"
    },
    {
      "id": "G03_RULE_QUALITY",
      "description": "Składnia, legal basis, temporalność, duplikaty, stuby i hardcode są sprawdzane przez dedykowane bramki.",
      "on_fail": "BLOCK"
    },
    {
      "id": "G04_RUNTIME_SAFETY",
      "description": "Runtime invariants, fail-closed, provenance i Decision Certificate są obecne przed publikacją werdyktu.",
      "on_fail": "BLOCK"
    },
    {
      "id": "G05_GOLDEN_REPLAY",
      "description": "Każda nieidentyczna zmiana werdyktu wymaga uzasadnienia prawnego.",
      "on_fail": "BLOCK"
    },
    {
      "id": "G06_PROGRESSIVE_DELIVERY",
      "description": "Bundle przechodzi canary, shadow, ramped, soak i ma auto-rollback.",
      "on_fail": "BLOCK"
    },
    {
      "id": "G07_STATUS_HANDOFF",
      "description": "Raport jest WDROZONY_100 dopiero po przejściu bramek i zapisaniu dowodów.",
      "on_fail": "BLOCK"
    }
  ],
